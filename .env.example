# Copy to .env and fill in real values before running `docker compose up`.

# Django — REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Set to False in production
DEBUG=False

# Private localhost port the app is exposed on (host nginx proxies to this).
# Pick the next free slot on the VPS (taken: 8000,8080,8090,8095,8096,8100,8110,8111,9090).
APP_PORT=8120

# Comma-separated hosts Django will serve
ALLOWED_HOSTS=netwells.co.ke,www.netwells.co.ke,localhost,127.0.0.1,backend

# Comma-separated origins trusted for CSRF (must include scheme)
CSRF_TRUSTED_ORIGINS=https://netwells.co.ke,https://www.netwells.co.ke

# HTTPS cookie hardening — keep True in production (behind HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# PostgreSQL (used by both the db service and the DATABASE_URL for the backend)
POSTGRES_DB=netwell
POSTGRES_USER=netwell
POSTGRES_PASSWORD=change-me-too
