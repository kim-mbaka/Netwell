# Copy to .env and fill in real values before running `docker compose up`.

# Django — REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Set to False in production
DEBUG=False

# Comma-separated hosts Django will serve
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL (used by both the db service and the DATABASE_URL for the backend)
POSTGRES_DB=netwell
POSTGRES_USER=netwell
POSTGRES_PASSWORD=change-me-too
